<div
  class="noticepro-notice-root"
  data-noticepro-notice
  data-endpoint="/apps/noticepro/notice"
  data-page-type="{{ request.page_type | escape }}"
  data-product-id="{% if request.page_type == 'product' %}{{ product.id }}{% endif %}"
  data-collection-id="{% if request.page_type == 'collection' %}{{ collection.id }}{% endif %}"
></div>

{% schema %}
{
  "name": "NoticePro Notice",
  "target": "section",
  "javascript": "notice.js",
  "stylesheet": "notice.css",
  "settings": []
}
{% endschema %}
