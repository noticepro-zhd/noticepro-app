<div
  data-noticepro-countdown
  data-endpoint="/apps/noticepro/countdown"
  data-page-type="{{ request.page_type | escape }}"
  data-product-id="{% if request.page_type == 'product' %}{{ product.id }}{% endif %}"
  data-collection-id="{% if request.page_type == 'collection' %}{{ collection.id }}{% endif %}"
></div>

{% schema %}
{
  "name": "NoticePro Countdown",
  "target": "body",
  "javascript": "countdown.js",
  "stylesheet": "countdown.css",
  "settings": []
}
{% endschema %}
